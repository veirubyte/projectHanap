<!DOCTYPE html>
<% 
  const hasChallengeForView = typeof hasConfiguredChallenge !== 'undefined'
    ? hasConfiguredChallenge
    : Boolean(item.secret_challenge && item.secret_answer);
  const matchScoreForView = typeof answerMatchScore !== 'undefined' ? answerMatchScore : null;
  const matchThresholdForView = typeof answerMatchThreshold !== 'undefined' ? answerMatchThreshold : 80;
%>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title><%= item.item_name %> - Project HANAP CSPC</title>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
  <style>
    @layer base {
      html, body { margin: 0; padding: 0; }
      body { overscroll-behavior: none; }
    }
    ::-webkit-scrollbar { display: none; }
  </style>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "background": "#F4F7FB",
            "primary": "#09436B",
            "primary-container": "#2B5B84",
            "on-surface": "#0F172A",
            "text-muted": "#64748B",
            "border-subtle": "#E2E8F0"
          },
          fontFamily: {
            sans: ["Plus Jakarta Sans", "sans-serif"]
          }
        }
      }
    };
  </script>
</head>
<body class="min-h-full bg-[#F4F7FB] font-sans text-slate-800 antialiased flex flex-col justify-between relative overflow-x-hidden">
  
  <!-- Ambient Aurora Canvas Background -->
  <div aria-hidden="true" class="fixed inset-0 pointer-events-none overflow-hidden -z-10">
    <div class="absolute -top-40 left-1/4 w-[600px] h-[500px] bg-gradient-to-br from-blue-300/30 via-teal-200/20 to-transparent rounded-full blur-[110px]"></div>
    <div class="absolute top-1/3 -right-28 w-[500px] h-[450px] bg-gradient-to-bl from-indigo-200/25 via-sky-200/15 to-transparent rounded-full blur-[100px]"></div>
    <div class="absolute -bottom-20 left-1/3 w-[550px] h-[450px] bg-gradient-to-tr from-teal-200/20 via-blue-200/15 to-transparent rounded-full blur-[120px]"></div>
  </div>

  <%- include('partials/navbar', { active: 'catalog' }) %>

  <!-- Main Content: Chic Glassmorphism Split Bento Grid -->
  <main class="w-full pt-2 pb-14 flex-1">
    <div class="max-w-[1440px] mx-auto px-3 sm:px-6 space-y-5">
      
      <!-- Flash Toasts -->
      <% if (typeof msg !== 'undefined' && msg) { %>
        <div class="p-4 rounded-2xl bg-teal-50 border border-teal-200 text-teal-800 text-xs sm:text-sm flex items-center gap-3 shadow-xs">
          <span class="material-symbols-outlined text-teal-600">check_circle</span>
          <span class="font-medium"><%= msg %></span>
        </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs sm:text-sm flex items-center gap-3 shadow-xs">
          <span class="material-symbols-outlined text-rose-600">error</span>
          <span class="font-medium"><%= error %></span>
        </div>
      <% } %>

      <!-- Back Navigation Bar with Case ID -->
      <div class="px-4 py-2.5 rounded-2xl bg-white/70 backdrop-blur-lg border border-white/80 shadow-[0_4px_16px_rgba(15,23,42,0.03)] flex items-center justify-between">
        <a href="/catalog" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#2B5B84] hover:text-[#09436B] transition-colors group">
          <span class="material-symbols-outlined text-[16px] transition-transform group-hover:-translate-x-0.5">arrow_back</span>
          <span>Back to Catalog</span>
        </a>
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-full bg-slate-100/90 text-[11px] font-bold tracking-wide text-slate-700 border border-slate-200/70">
            Case #<%= item.report_type === 'found' ? 'F' : 'L' %>-<%= item.id %>
          </span>
          <% if (user && (user.id === item.user_id || user.role === 'admin')) { %>
            <div class="h-3 w-px bg-slate-200"></div>
            <form action="/items/<%= item.id %>/delete" method="POST" onsubmit="return confirm('Delete this report?');" class="inline">
              <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
              <% } %>
              <button type="submit" class="inline-flex items-center gap-1 text-[11px] font-medium text-slate-400 hover:text-rose-600 transition-colors">
                <span class="material-symbols-outlined text-[14px]">delete</span>
                <span>Delete</span>
              </button>
            </form>
          <% } %>
        </div>
      </div>

      <!-- Split Showcase Bento Grid (7 cols / 5 cols) -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
        
        <!-- ================= LEFT SHOWCASE (55% = 7 cols) ================= -->
        <div class="md:col-span-7 flex flex-col gap-4">
          
          <!-- Edge-to-edge rounded glass media card -->
          <div class="group relative rounded-3xl p-3 bg-white/80 backdrop-blur-xl border border-white/90 shadow-[0_16px_40px_rgba(15,23,42,0.06),inset_0_1px_1px_rgba(255,255,255,0.9)] transition-all">
            
            <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden bg-slate-100 border border-slate-200/50 flex items-center justify-center">
              <% if (item.image_path) { %>
                <img src="<%= item.image_path %>" alt="<%= item.item_name %>" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"/>
              <% } else { %>
                <div class="flex flex-col items-center justify-center text-slate-400 p-6">
                  <span class="material-symbols-outlined text-6xl">inventory_2</span>
                  <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider mt-2"><%= item.category %></span>
                </div>
              <% } %>

              <!-- Frosted Privacy Badge Overlay -->
              <div class="absolute bottom-3 left-3 bg-slate-900/70 backdrop-blur-md text-white text-xs font-semibold px-3 py-1.5 rounded-full flex items-center gap-1.5 shadow-[0_0_16px_rgba(0,0,0,0.35)] border border-white/20">
                <span class="w-1.5 h-1.5 rounded-full <%= item.status === 'claimed' ? 'bg-slate-400' : 'bg-emerald-400 animate-pulse' %>"></span>
                <span><%= item.status === 'claimed' ? 'Reunited / Resolved' : '🔒 Verified Report' %></span>
              </div>

              <!-- Report Type Badge Top Left -->
              <div class="absolute top-3 left-3">
                <% if (item.report_type === 'found') { %>
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-teal-500 text-white shadow-xs">
                    Found Item
                  </span>
                <% } else { %>
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-rose-600 text-white shadow-xs">
                    Lost Item
                  </span>
                <% } %>
              </div>
            </div>

            <!-- Content inside glass card -->
            <div class="p-4 sm:p-5 flex flex-col gap-3">
              <h1 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight leading-snug">
                <%= item.item_name %>
              </h1>

              <!-- 3 Glass Metadata Chips -->
              <div class="flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/85 backdrop-blur-md border border-slate-200/80 text-slate-700 text-xs font-semibold shadow-2xs">
                  <span>📁</span> <%= item.category %>
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/85 backdrop-blur-md border border-slate-200/80 text-slate-700 text-xs font-semibold shadow-2xs">
                  <span>📍</span> <%= item.location_found_lost %>
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/85 backdrop-blur-md border border-slate-200/80 text-slate-700 text-xs font-semibold shadow-2xs">
                  <span>🕒</span> <%= timeAgo(item.date_reported) %>
                </span>
              </div>

              <!-- Item Description -->
              <div class="pt-2">
                <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Description</h4>
                <p class="text-slate-700 text-sm leading-relaxed whitespace-pre-line">
                  <%= item.description %>
                </p>
              </div>

              <!-- Custody Information (if set) -->
              <% if (item.custody_mode) { %>
                <div class="pt-1 flex items-center gap-2 text-xs font-medium text-slate-600">
                  <span class="material-symbols-outlined text-base text-[#2B5B84]">security</span>
                  <span>Custody Mode: <strong class="text-slate-800"><%= item.custody_mode === 'security_desk' ? 'Main Security Desk' : 'Peer Coordination' %></strong></span>
                </div>
              <% } %>

              <!-- Reporter Meta -->
              <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
                <span>Reported by: <strong class="text-slate-700"><%= item.reporter_name %></strong> (<%= item.reporter_role %>)</span>
                <span>Date: <%= new Date(item.date_reported).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
              </div>
            </div>
          </div>
        </div>

        <!-- ================= RIGHT INTERACTIVE CLAIM STUDIO (45% = 5 cols) ================= -->
        <div class="md:col-span-5 flex flex-col gap-4" id="claim">
          
          <!-- TOP GLASS POD: Campus Match Engine card -->
          <div class="relative rounded-3xl p-5 bg-gradient-to-br from-teal-500/15 via-emerald-500/10 to-cyan-500/15 backdrop-blur-xl border border-teal-300/60 shadow-[0_12px_32px_rgba(13,148,136,0.12),inset_0_1px_2px_rgba(255,255,255,0.8)] overflow-hidden">
            <div class="absolute -top-10 -right-10 w-32 h-32 bg-[#0D9488]/20 rounded-full blur-2xl pointer-events-none"></div>
            
            <div class="flex items-center justify-between gap-3 mb-3.5">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-[#0D9488] text-white flex items-center justify-center shadow-md shadow-teal-700/20">
                  <span class="material-symbols-outlined text-[19px]">auto_awesome</span>
                </div>
                <div>
                  <span class="text-[10px] font-extrabold tracking-wider uppercase text-teal-800 block">Ownership Match</span>
                  <span class="text-xs font-bold text-teal-950">
                    <%= hasChallengeForView ? 'Secret-answer verification' : 'Manual ownership review' %>
                  </span>
                </div>
              </div>

              <!-- The expected answer stays server-side; only its computed score is rendered. -->
              <div class="relative w-14 h-14 flex items-center justify-center shrink-0"
                   role="img"
                   aria-label="<%= matchScoreForView === null ? 'Answer match not yet measured' : `Answer match ${matchScoreForView}%` %>">
                <svg class="w-12 h-12 -rotate-90" viewBox="0 0 36 36">
                  <path class="text-teal-200/60" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-width="3.5"></path>
                  <path class="<%= matchScoreForView === null ? 'text-teal-600' : (matchScoreForView >= matchThresholdForView ? 'text-emerald-600' : 'text-rose-600') %>" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-dasharray="<%= matchScoreForView === null ? 0 : matchScoreForView %>, 100" stroke-linecap="round" stroke-width="3.5"></path>
                </svg>
                <span class="absolute text-[11px] font-extrabold text-teal-900 tracking-tighter">
                  <%= matchScoreForView === null ? '--' : matchScoreForView + '%' %>
                </span>
              </div>
            </div>

            <!-- Highlight Banner -->
            <div class="p-2.5 rounded-xl bg-white/80 backdrop-blur-md border border-teal-200/80 shadow-2xs flex items-center gap-2 text-xs font-bold text-teal-900 mb-3">
              <span class="<%= matchScoreForView !== null && matchScoreForView < matchThresholdForView ? 'text-rose-600' : 'text-amber-500' %>">
                <%= matchScoreForView === null ? '🔒' : (matchScoreForView >= matchThresholdForView ? '✓' : '!') %>
              </span>
              <span>
                <% if (matchScoreForView !== null) { %>
                  Answer match: <%= matchScoreForView %>% · <%= matchScoreForView >= matchThresholdForView ? `meets the ${matchThresholdForView}% minimum` : `below the ${matchThresholdForView}% minimum` %>
                <% } else if (hasChallengeForView) { %>
                  Submit your answer to calculate its match score. At least <%= matchThresholdForView %>% is required.
                <% } else { %>
                  No private answer is configured. Claims are reviewed manually.
                <% } %>
              </span>
            </div>

            <!-- Match Tags -->
            <div class="flex flex-wrap items-center gap-1.5">
              <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-teal-600/10 border border-teal-600/20 text-teal-900 text-[11px] font-bold">
                <%= hasChallengeForView ? 'Server-checked answer' : 'Manual review' %>
              </span>
              <% if (hasChallengeForView) { %>
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-teal-600/10 border border-teal-600/20 text-teal-900 text-[11px] font-bold">
                  <%= matchThresholdForView %>% minimum to submit
                </span>
              <% } %>
            </div>
          </div>

          <!-- BOTTOM GLASS POD: Interactive 'Verify Ownership' card -->
          <div class="rounded-3xl p-5 sm:p-6 bg-white/80 backdrop-blur-xl border border-white/90 shadow-[0_16px_40px_rgba(15,23,42,0.06),inset_0_1px_1px_rgba(255,255,255,0.9)] flex flex-col gap-4">
            
            <div class="flex items-center justify-between border-b border-slate-100/80 pb-3">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[#2B5B84]"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-700">Ownership Resolution</span>
              </div>
              <span class="text-[11px] font-bold text-slate-500 bg-slate-100/80 px-2.5 py-0.5 rounded-full">
                <%= item.report_type === 'found' ? 'Claim Studio' : 'Lost Item Status' %>
              </span>
            </div>

            <% if (!user) { %>
              <!-- Unauthenticated State -->
              <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 text-center space-y-3">
                <p class="text-xs text-slate-600">Please sign in to your institutional or guest account to file an ownership claim.</p>
                <a href="/login" class="inline-flex items-center gap-1 px-4 py-2 rounded-xl bg-[#09436B] text-white text-xs font-bold shadow-xs hover:bg-[#204667] transition">
                  <span>Sign In to Claim</span>
                  <span class="material-symbols-outlined text-sm">login</span>
                </a>
              </div>
            <% } else if (user.id === item.user_id) { %>
              <!-- Owner State -->
              <div class="p-4 rounded-2xl bg-sky-50 border border-sky-200 text-sky-900 space-y-2">
                <div class="flex items-center gap-2 font-bold text-xs">
                  <span class="material-symbols-outlined text-sky-700 text-base">verified</span>
                  <span>You reported this item</span>
                </div>
                <p class="text-xs text-sky-800">
                  You are the creator of this report. You can review ongoing claims or manage its resolution status in your dashboard.
                </p>
                <div class="pt-2 flex items-center gap-2">
                  <a href="/claims" class="px-3 py-1.5 rounded-xl bg-white text-sky-900 text-xs font-bold border border-sky-300 shadow-2xs hover:bg-sky-100 transition">
                    View Claims for this Item
                  </a>
                  <a href="/my-reports" class="px-3 py-1.5 rounded-xl bg-sky-700 text-white text-xs font-bold shadow-2xs hover:bg-sky-800 transition">
                    Manage Report
                  </a>
                </div>
              </div>
            <% } else if (existingClaim) { %>
              <!-- Claim Already Submitted -->
              <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 space-y-2">
                <div class="flex items-center gap-2 font-bold text-xs">
                  <span class="material-symbols-outlined text-amber-700 text-base">pending_actions</span>
                  <span>Claim Status: <%= existingClaim.status.toUpperCase() %></span>
                </div>
                <p class="text-xs text-amber-800">
                  You already submitted an ownership claim for this item. Open the conversation thread to communicate with the finder.
                </p>
                <div class="pt-1">
                  <a href="/claims/<%= existingClaim.id %>" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-amber-700 text-white text-xs font-bold shadow-2xs hover:bg-amber-800 transition">
                    <span>Open Claim Chat</span>
                    <span class="material-symbols-outlined text-sm">chat</span>
                  </a>
                </div>
              </div>
            <% } else if (item.status === 'claimed') { %>
              <!-- Already Claimed -->
              <div class="p-4 rounded-2xl bg-slate-100 border border-slate-200 text-slate-600 text-xs text-center space-y-1">
                <span class="material-symbols-outlined text-slate-400 text-2xl">check_circle</span>
                <p class="font-bold text-slate-800">This item has already been reunited.</p>
                <p>No new claims can be filed on this case.</p>
              </div>
            <% } else if (item.report_type !== 'found' || item.status !== 'active') { %>
              <div class="p-4 rounded-2xl bg-slate-100 border border-slate-200 text-slate-600 text-xs text-center">
                Claims can only be submitted for active found-item reports.
              </div>
            <% } else { %>
              <!-- Active Claim Submission Form -->
              <!-- Verification Question Speech Bubble -->
              <div class="relative p-3.5 rounded-2xl bg-gradient-to-r from-slate-50 to-blue-50/50 border border-blue-100/80 shadow-2xs">
                <div class="flex items-start gap-2.5">
                  <span class="material-symbols-outlined text-[#2B5B84] text-[20px] shrink-0 mt-0.5">help</span>
                  <div class="space-y-0.5">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Finder asks:</p>
                    <label class="block text-xs sm:text-sm font-bold text-slate-900 leading-snug" for="proofDetails">
                      “<%= item.secret_challenge || 'Please provide identifiable proof of ownership (e.g. unique scratches, serial number, lockscreen wallpaper, or internal contents).' %>”
                    </label>
                  </div>
                </div>
              </div>

              <!-- Claim Form -->
              <form class="flex flex-col gap-3.5" action="/items/<%= item.id %>/claim" method="POST">
                <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                <% } %>
                <div class="relative">
                  <textarea 
                    class="w-full h-24 p-3.5 rounded-xl border border-slate-200/90 bg-white/90 text-slate-900 placeholder:text-slate-400 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#3B82F6] focus:border-[#3B82F6] shadow-inner transition-all resize-none" 
                    id="proofDetails" 
                    name="proof_details" 
                    placeholder="Provide your specific answer and identifying proof..." 
                    maxlength="500"
                    required
                  ></textarea>
                </div>
                <p class="text-[11px] text-slate-500 -mt-2">
                  <% if (hasChallengeForView) { %>
                    Your answer is checked privately. You need at least <%= matchThresholdForView %>% to file a claim; include only details you know.
                  <% } else { %>
                    Include your answer and ownership details (500 characters maximum). The reporter will review it manually.
                  <% } %>
                </p>

                <button class="w-full h-11 rounded-xl bg-gradient-to-r from-[#2B5B84] to-[#1E40AF] hover:from-[#204463] hover:to-[#17338e] active:scale-[0.99] text-white text-xs sm:text-sm font-bold flex items-center justify-center gap-2 shadow-[0_8px_20px_rgba(43,91,132,0.3)] transition-all cursor-pointer" type="submit">
                  <span>Submit Claim</span>
                  <span class="material-symbols-outlined text-base">arrow_forward</span>
                </button>
              </form>

              <!-- Subtle Security Desk Link -->
              <div class="pt-2 text-center border-t border-slate-100">
                <a class="inline-flex items-center gap-1 text-[11px] font-medium text-slate-400 hover:text-slate-700 transition-colors" href="/claims/guest-claim?case=<%= item.id %>">
                  Parent or Guest? Route to Security Desk &rarr;
                </a>
              </div>
            <% } %>
          </div>

          <!-- Similar Items Carousel / Suggestions -->
          <% if (typeof similar !== 'undefined' && similar.length > 0) { %>
            <div class="p-4 rounded-2xl bg-white/60 backdrop-blur-md border border-white/80 shadow-2xs space-y-2">
              <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider">Other <%= item.category %> Items</h4>
              <div class="space-y-2">
                <% similar.forEach(sim => { %>
                  <a href="/items/<%= sim.id %>" class="flex items-center justify-between p-2 rounded-xl bg-white/80 hover:bg-white border border-slate-200/60 text-xs transition">
                    <span class="font-semibold text-slate-800 truncate max-w-[200px]"><%= sim.item_name %></span>
                    <span class="text-[11px] text-slate-400"><%= sim.location_found_lost %></span>
                  </a>
                <% }) %>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="w-full border-t border-white/60 bg-white/50 backdrop-blur-md py-4 mt-8">
    <div class="max-w-[1060px] mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-400 font-medium">
      <div class="flex items-center gap-2">
        <span class="font-bold text-slate-700">Project HANAP</span>
        <span>•</span>
        <span>CSPC Camarines Sur</span>
      </div>
      <div>© 2026 CSPC Campus Care Network</div>
    </div>
  </footer>
</body>
</html>
