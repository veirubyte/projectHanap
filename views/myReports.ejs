<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>My Reports - Project HANAP CSPC</title>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
  <style>
    @layer base {
      html, body { margin: 0; padding: 0; }
      body { overscroll-behavior: none; }
    }
  </style>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "background": "#F4F7FB",
            "primary": "#09436B",
            "primary-container": "#2B5B84",
            "on-surface": "#0F172A",
            "text-muted": "#64748B",
            "border-subtle": "#E2E8F0"
          },
          fontFamily: {
            sans: ["Plus Jakarta Sans", "sans-serif"]
          }
        }
      }
    };
  </script>
</head>
<body class="min-h-full bg-[#F4F7FB] font-sans text-slate-800 antialiased flex flex-col justify-between relative overflow-x-hidden">
  
  <!-- Ambient Aurora Canvas Background -->
  <div aria-hidden="true" class="fixed inset-0 pointer-events-none overflow-hidden -z-10">
    <div class="absolute -top-[15%] -left-[10%] w-[540px] h-[540px] rounded-full bg-[#2B5B84]/10 blur-[130px]"></div>
    <div class="absolute top-[30%] -right-[10%] w-[580px] h-[580px] rounded-full bg-[#3B82F6]/10 blur-[140px]"></div>
  </div>

  <%- include('partials/navbar', { active: 'my-reports' }) %>

  <!-- Main Container -->
  <main class="w-full max-w-[1440px] mx-auto px-3 sm:px-6 py-4 sm:py-6 flex-1 space-y-6">
    
    <!-- Flash Messages -->
    <% if (typeof msg !== 'undefined' && msg) { %>
      <div class="p-4 rounded-2xl bg-teal-50 border border-teal-200 text-teal-800 text-xs sm:text-sm flex items-center gap-3 shadow-xs">
        <span class="material-symbols-outlined text-teal-600">check_circle</span>
        <span class="font-medium"><%= msg %></span>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs sm:text-sm flex items-center gap-3 shadow-xs">
        <span class="material-symbols-outlined text-rose-600">error</span>
        <span class="font-medium"><%= error %></span>
      </div>
    <% } %>

    <!-- Header -->
    <div class="rounded-2xl p-5 bg-white/75 backdrop-blur-xl border border-white/80 shadow-[0_4px_24px_rgba(15,23,42,0.03)] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900">My Reported Items</h1>
        <p class="text-xs text-slate-500 mt-0.5">Manage your active lost and found reports, update item statuses, or close resolved cases.</p>
      </div>
      <div class="flex items-center gap-2">
        <a href="/items/new?type=lost" class="px-4 py-2 rounded-xl text-xs font-semibold bg-rose-600 hover:bg-rose-700 text-white shadow-xs transition">
          + Report Lost
        </a>
        <% if (user.role !== 'parent/guest' && user.role !== 'guest' && user.role !== 'parent') { %>
          <a href="/items/new?type=found" class="px-4 py-2 rounded-xl text-xs font-semibold bg-teal-600 hover:bg-teal-700 text-white shadow-xs transition">
            + Report Found
          </a>
        <% } %>
      </div>
    </div>

    <!-- Reports Table / Cards -->
    <div class="rounded-3xl p-5 sm:p-6 bg-white/80 backdrop-blur-xl border border-white/90 shadow-[0_8px_30px_rgba(15,23,42,0.04)]">
      <% if (reports.length === 0) { %>
        <div class="py-16 text-center text-slate-400 space-y-2">
          <span class="material-symbols-outlined text-5xl text-slate-300">inventory</span>
          <p class="text-sm font-semibold text-slate-600">You haven't submitted any reports yet.</p>
          <p class="text-xs text-slate-400">Click a button above to report a lost or found campus belonging.</p>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% reports.forEach(r => { %>
            <div class="p-4 rounded-2xl bg-white border border-slate-200/80 shadow-2xs hover:shadow-xs transition-all flex flex-col justify-between space-y-3">
              <div>
                <div class="flex items-start justify-between gap-2 mb-2">
                  <div class="flex items-center gap-2">
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase <%= r.report_type === 'found' ? 'bg-teal-50 text-teal-800 border border-teal-200' : 'bg-rose-50 text-rose-800 border border-rose-200' %>">
                      <%= r.report_type %>
                    </span>
                    <span class="text-[10px] font-bold uppercase text-slate-400 bg-slate-100 px-2 py-0.5 rounded-md">
                      <%= r.category %>
                    </span>
                  </div>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase <%= r.status === 'claimed' ? 'bg-slate-100 text-slate-700' : 'bg-emerald-50 text-emerald-800' %>">
                    <%= r.status %>
                  </span>
                </div>

                <h3 class="text-sm font-bold text-slate-900 line-clamp-1"><%= r.item_name %></h3>
                <p class="text-xs text-slate-500 line-clamp-2 mt-1"><%= r.description %></p>
                
                <div class="flex items-center gap-1 text-[11px] text-slate-400 pt-2">
                  <span class="material-symbols-outlined text-[14px]">location_on</span>
                  <span><%= r.location_found_lost %> • Reported <%= timeAgo(r.date_reported) %></span>
                </div>
              </div>

              <!-- Action Bar -->
              <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
                <a href="/items/<%= r.id %>" class="text-xs font-semibold text-[#09436B] hover:underline">
                  View Detail
                </a>

                <div class="flex items-center gap-2">
                  <% if (r.status === 'active') { %>
                    <form action="/items/<%= r.id %>/status" method="POST" class="inline">
                      <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                      <% } %>
                      <input type="hidden" name="status" value="claimed"/>
                      <button type="submit" class="px-2.5 py-1 rounded-lg bg-teal-50 text-teal-800 hover:bg-teal-100 text-[11px] font-bold border border-teal-200 transition">
                        Mark Reunited
                      </button>
                    </form>
                  <% } %>

                  <form action="/items/<%= r.id %>/delete" method="POST" onsubmit="return confirm('Delete this report?');" class="inline">
                    <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                    <% } %>
                    <button type="submit" class="p-1 rounded-lg text-slate-400 hover:text-rose-600 transition" title="Delete report">
                      <span class="material-symbols-outlined text-base">delete</span>
                    </button>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>

