<!DOCTYPE html>
<html class="register-page" lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Create Account - HANAP CSPC</title>
  <link rel="stylesheet" href="/css/style.css"/>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "background": "#F0F4FA",
            "primary": "#09436B",
            "primary-container": "#2B5B84",
            "primary-hover": "#204667",
            "on-primary": "#ffffff",
            "secondary": "#3B82F6",
            "on-surface": "#0F172A",
            "text-muted": "#64748B",
            "border-light": "#E2E8F0"
          },
          fontFamily: {
            sans: ["Plus Jakarta Sans", "sans-serif"]
          }
        }
      }
    };
  </script>
</head>
<body class="register-page bg-[#EFF4FB] text-[#0F172A] font-sans antialiased min-h-screen relative overflow-x-hidden flex items-center justify-center p-4 md:p-8">
  
  <!-- Ambient Aurora Canvas Background -->
  <div aria-hidden="true" class="fixed inset-0 pointer-events-none overflow-hidden -z-10">
    <div class="absolute -top-[18%] -left-[10%] w-[580px] h-[580px] rounded-full bg-[#2B5B84]/20 blur-[120px]"></div>
    <div class="absolute top-[25%] -right-[12%] w-[640px] h-[640px] rounded-full bg-[#3B82F6]/20 blur-[140px]"></div>
    <div class="absolute -bottom-[15%] left-[20%] w-[520px] h-[520px] rounded-full bg-[#09436B]/15 blur-[130px]"></div>
    <div class="absolute inset-0 bg-gradient-to-tr from-white/30 via-transparent to-white/40"></div>
  </div>

  <!-- Floating Frosted Glass Registration Portal -->
  <main class="w-full max-w-[1020px] bg-white/[0.82] backdrop-blur-2xl rounded-3xl shadow-[0_24px_60px_-15px_rgba(9,67,107,0.14),0_0_0_1px_rgba(255,255,255,0.9)_inset,0_1px_3px_0_rgba(0,0,0,0.05)] border border-white/60 overflow-hidden flex flex-col md:flex-row relative">
    
    <!-- LEFT SHOWCASE: Frosted glass panel with floating feature pills -->
    <aside class="w-full md:w-[38%] bg-gradient-to-b from-[#EAF1F8]/90 via-[#EAF1F8]/60 to-white/60 backdrop-blur-xl border-b md:border-b-0 md:border-r border-white/70 p-8 md:p-10 flex flex-col justify-between relative overflow-hidden select-none">
      <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-white to-transparent"></div>
      <div>
        <!-- Logo & Brand Header -->
        <div class="flex items-center gap-3 mb-10">
          <a href="/" class="w-10 h-10 rounded-2xl bg-[#EEF5F0] border border-[#D5E5DA] text-[#2D6A4F] flex items-center justify-center shrink-0 shadow-xs hover:scale-105 transition-transform" title="Back to Welcome Portal">
            <span class="material-symbols-outlined text-[20px] text-[#2D6A4F]">search</span>
          </a>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-lg font-bold text-[#09436B] tracking-tight">HANAP</span>
              <span class="text-[10px] font-bold uppercase px-1.5 py-0.5 rounded-md bg-white/90 text-[#2B5B84] border border-slate-200/80 shadow-xs">CSPC</span>
            </div>
            <p class="text-[11px] font-medium text-slate-500">Nabua Campus</p>
          </div>
        </div>

        <!-- Community Tagline -->
        <h1 class="text-2xl md:text-3xl font-extrabold text-[#0F172A] tracking-tight mb-2">
          Join the community.
        </h1>
        <p class="text-xs text-slate-500 mb-8 font-medium">Reconnecting lost belongings with campus care.</p>

        <!-- 3 Floating Feature Pills -->
        <div class="space-y-3">
          <div class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-white/85 backdrop-blur-md border border-white shadow-sm hover:shadow transition-shadow">
            <span class="text-base select-none">⚡</span>
            <span class="text-xs font-semibold text-[#0F172A]">Instant AI Matching</span>
          </div>
          <div class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-white/85 backdrop-blur-md border border-white shadow-sm hover:shadow transition-shadow">
            <span class="text-base select-none">🔒</span>
            <span class="text-xs font-semibold text-[#0F172A]">Privacy First</span>
          </div>
          <div class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl bg-white/85 backdrop-blur-md border border-white shadow-sm hover:shadow transition-shadow">
            <span class="text-base select-none">🤝</span>
            <span class="text-xs font-semibold text-[#0F172A]">Safe Handover</span>
          </div>
        </div>
      </div>

      <!-- Footer Attribution -->
      <div class="pt-8 text-[11px] font-medium text-slate-400">
        CSPC Campus Care Network
      </div>
    </aside>

    <!-- RIGHT PANEL: Registration Form -->
    <section class="w-full md:w-[62%] p-8 md:p-10 flex flex-col justify-center">
      <div class="max-w-[540px] w-full mx-auto space-y-5">
        
        <!-- Header and Role Selection Toggle: [ CSPC Student / Staff ] [ Parent / Guest ] -->
        <div class="space-y-3">
          <div>
            <h2 class="text-2xl md:text-3xl font-extrabold text-[#0F172A] tracking-tight" id="regHeading">
              Create Account
            </h2>
            <p class="text-xs text-slate-500 mt-1" id="regSubtitle">
              <%= (typeof category !== 'undefined' && category === 'guest') ? 'For parents, guardians, and external campus visitors.' : 'For CSPC students and faculty/staff members.' %>
            </p>
          </div>

          <!-- Segmented Role Toggle: [ CSPC Student / Staff ] [ Parent / Guest ] -->
          <div class="w-full bg-[#F1F5F9] p-1.5 rounded-2xl flex items-center border border-slate-200/80 shadow-inner" role="tablist" aria-label="Account Role Selection">
            <button class="flex-1 py-2.5 px-4 rounded-xl text-xs sm:text-sm font-bold text-center transition-all cursor-pointer <%= (typeof category !== 'undefined' && category === 'guest') ? 'text-slate-500 hover:text-slate-800' : 'text-[#09436B] bg-white shadow-xs' %>" id="tab-institution" data-reg-category="institution" type="button" role="tab" aria-selected="<%= (typeof category === 'undefined' || category !== 'guest') %>">
              CSPC Student / Staff
            </button>
            <button class="flex-1 py-2.5 px-4 rounded-xl text-xs sm:text-sm font-semibold text-center transition-all cursor-pointer <%= (typeof category !== 'undefined' && category === 'guest') ? 'text-[#09436B] bg-white shadow-xs' : 'text-slate-500 hover:text-slate-800' %>" id="tab-guest" data-reg-category="guest" type="button" role="tab" aria-selected="<%= (typeof category !== 'undefined' && category === 'guest') %>">
              Parent / Guest
            </button>
          </div>

          <!-- Role Guard Notice: Admin accounts cannot be created by users -->
          <div class="flex items-center gap-1.5 text-[11px] text-slate-500 font-medium">
            <span class="material-symbols-outlined text-[15px] text-slate-400">admin_panel_settings</span>
            <span>Registration is available for Student/Staff and Guests. Administrative accounts are centrally managed.</span>
          </div>
        </div>

        <!-- Reusable Alert DIV Container (Accessible role="alert") -->
        <div id="regAlertContainer" class="<%= (typeof errorMessage !== 'undefined' && errorMessage) ? '' : 'hidden' %>" role="alert">
          <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="p-4 rounded-2xl bg-rose-50/90 border border-rose-200/90 text-rose-800 text-xs shadow-xs space-y-2 animate-fadeIn" id="serverRegErrorBox">
              <div class="flex items-start gap-2.5">
                <span class="material-symbols-outlined text-rose-600 text-lg shrink-0 mt-0.5">warning</span>
                <div class="flex-1">
                  <strong class="font-bold text-rose-900 block mb-0.5 text-xs">
                    <%= typeof errorTitle !== 'undefined' && errorTitle ? errorTitle : 'Registration requirement not met' %>
                  </strong>
                  <div class="whitespace-pre-line text-rose-700 leading-relaxed font-medium">
                    <%= errorMessage %>
                  </div>
                </div>
              </div>

              <!-- Contextual Action Buttons in Alert -->
              <% if (typeof action !== 'undefined' && action === 'sign_in') { %>
                <div class="pt-1.5 pl-7">
                  <a href="/login?email=<%= encodeURIComponent(typeof values !== 'undefined' && values.email ? values.email : '') %>" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-white hover:bg-rose-100/60 text-rose-900 font-bold border border-rose-300 shadow-2xs transition-all">
                    <span>Sign In</span>
                    <span class="material-symbols-outlined text-sm">login</span>
                  </a>
                </div>
              <% } else if (typeof action !== 'undefined' && action === 'switch_to_guest') { %>
                <div class="pt-1.5 pl-7">
                  <button type="button" data-reg-category="guest" class="px-3.5 py-1.5 rounded-xl bg-white hover:bg-rose-100/60 text-rose-900 font-bold border border-rose-300 shadow-2xs transition-all flex items-center gap-1.5 cursor-pointer">
                    <span>Switch to Guest Registration</span>
                    <span class="material-symbols-outlined text-sm">arrow_forward</span>
                  </button>
                </div>
              <% } %>
            </div>
          <% } %>
        </div>

        <!-- Registration Form (No Role Selectors - Server Handles Role) -->
        <form class="space-y-4" action="/register" method="POST" id="regForm" novalidate>
          <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
          <% } %>
          <input type="hidden" name="category" id="categoryInput" value="<%= (typeof category !== 'undefined' && category === 'guest') ? 'guest' : 'institution' %>"/>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Full Name -->
            <div>
              <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="fullName">
                Full Name *
              </label>
              <input 
                class="w-full h-10 px-3.5 rounded-xl bg-white/90 border text-slate-900 text-sm placeholder:text-slate-400 focus:outline-none focus:border-[#3B82F6] focus:ring-4 focus:ring-[#3B82F6]/15 transition shadow-2xs <%= (typeof invalidFields !== 'undefined' && invalidFields.includes('full_name')) ? 'border-rose-500 ring-2 ring-rose-200' : 'border-slate-200/90' %>" 
                id="fullName" 
                name="full_name" 
                placeholder="Juan Dela Cruz" 
                type="text" 
                autocomplete="name"
                value="<%= (typeof values !== 'undefined' && values.full_name) || '' %>"
              />
            </div>

            <!-- Email Address -->
            <div>
              <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="email" id="emailLabel">
                <%= (typeof category !== 'undefined' && category === 'guest') ? 'Email Address *' : 'CSPC Institutional Email *' %>
              </label>
              <input 
                class="w-full h-10 px-3.5 rounded-xl bg-white/90 border text-slate-900 text-sm placeholder:text-slate-400 focus:outline-none focus:border-[#3B82F6] focus:ring-4 focus:ring-[#3B82F6]/15 transition shadow-2xs <%= (typeof invalidFields !== 'undefined' && invalidFields.includes('email')) ? 'border-rose-500 ring-2 ring-rose-200' : 'border-slate-200/90' %>" 
                id="email" 
                name="email" 
                placeholder="<%= (typeof category !== 'undefined' && category === 'guest') ? 'name@gmail.com' : 'juan@my.cspc.edu.ph' %>" 
                type="email" 
                autocomplete="email"
                value="<%= (typeof values !== 'undefined' && values.email) || '' %>"
              />
            </div>

            <!-- Password with Eye Toggle -->
            <div>
              <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="password">
                Password *
              </label>
              <div class="relative">
                <input 
                  class="w-full h-10 pl-3.5 pr-10 rounded-xl bg-white/90 border text-slate-900 text-sm focus:outline-none focus:border-[#3B82F6] focus:ring-4 focus:ring-[#3B82F6]/15 transition shadow-2xs <%= (typeof invalidFields !== 'undefined' && invalidFields.includes('password')) ? 'border-rose-500 ring-2 ring-rose-200' : 'border-slate-200/90' %>" 
                  id="password" 
                  name="password" 
                  type="password"
                  autocomplete="new-password"
                />
                <button 
                  aria-label="Toggle password visibility" 
                  class="absolute right-3 top-2.5 text-slate-400 hover:text-slate-700 transition-colors focus:outline-none" 
                  data-password-field="password" data-password-icon="eyeIcon1"
                  type="button">
                  <span class="material-symbols-outlined text-[19px]" id="eyeIcon1">visibility</span>
                </button>
              </div>
            </div>

            <!-- Confirm Password with Eye Toggle -->
            <div>
              <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="confirm_password">
                Confirm Password *
              </label>
              <div class="relative">
                <input 
                  class="w-full h-10 pl-3.5 pr-10 rounded-xl bg-white/90 border text-slate-900 text-sm focus:outline-none focus:border-[#3B82F6] focus:ring-4 focus:ring-[#3B82F6]/15 transition shadow-2xs <%= (typeof invalidFields !== 'undefined' && invalidFields.includes('confirm_password')) ? 'border-rose-500 ring-2 ring-rose-200' : 'border-slate-200/90' %>" 
                  id="confirm_password" 
                  name="confirm_password" 
                  type="password"
                  autocomplete="new-password"
                />
                <button 
                  aria-label="Toggle confirm password visibility" 
                  class="absolute right-3 top-2.5 text-slate-400 hover:text-slate-700 transition-colors focus:outline-none" 
                  data-password-field="confirm_password" data-password-icon="eyeIcon2"
                  type="button">
                  <span class="material-symbols-outlined text-[19px]" id="eyeIcon2">visibility</span>
                </button>
              </div>
            </div>
          </div>

          <!-- 3-Segment Visual Password Strength Indicator -->
          <div class="pt-1 space-y-1.5">
            <div class="flex items-center justify-between text-[11px] text-slate-500">
              <span class="font-semibold" id="strengthText">Password Strength: Empty</span>
              <span class="text-[10px] text-slate-400">8+ chars, upper, lower, number &amp; symbol</span>
            </div>
            <div class="grid grid-cols-3 gap-1.5 h-2 w-full" aria-label="Password strength meter" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="3" id="strengthMeter">
              <div class="h-full rounded-full bg-slate-200 transition-colors duration-300" id="bar1"></div>
              <div class="h-full rounded-full bg-slate-200 transition-colors duration-300" id="bar2"></div>
              <div class="h-full rounded-full bg-slate-200 transition-colors duration-300" id="bar3"></div>
            </div>
          </div>

          <!-- Terms Checkbox -->
          <div class="pt-2">
            <label class="flex items-center gap-2 cursor-pointer select-none">
              <input checked class="w-4 h-4 rounded text-[#2B5B84] focus:ring-[#3B82F6]/30 accent-[#2B5B84] border-slate-300 cursor-pointer" id="termsCheck" type="checkbox"/>
              <span class="text-xs text-slate-600 font-medium">
                Agree to CSPC Lost &amp; Found community guidelines and safety policies
              </span>
            </label>
          </div>

          <!-- Tactile Gradient 'Create Account' Button -->
          <div class="pt-2">
            <button 
              class="w-full h-11 bg-gradient-to-r from-[#2B5B84] via-[#1E4E75] to-[#09436B] hover:brightness-110 active:scale-[0.99] text-white text-sm font-semibold rounded-xl shadow-[0_4px_16px_rgba(43,91,132,0.32),0_1px_2px_rgba(255,255,255,0.25)_inset] transition-all flex items-center justify-center gap-1.5 text-center cursor-pointer" 
              type="submit"
              id="createAccountBtn">
              <span>Create Account</span>
              <span class="material-symbols-outlined text-base">arrow_forward</span>
            </button>
          </div>

          <!-- Bottom Navigation Link (No Dead Links) -->
          <div class="text-center pt-2">
            <a class="text-xs text-slate-500 hover:text-slate-800 transition-colors" href="/login">
              Already registered? <span class="font-semibold text-[#2B5B84] hover:text-[#3B82F6] underline decoration-[#2B5B84]/40 underline-offset-2">Sign in</span>
            </a>
          </div>
        </form>
      </div>
    </section>
  </main>

  <script>
    let activeRegCategory = document.getElementById('categoryInput').value;

    function switchRegCategory(cat) {
      activeRegCategory = cat;
      const tabInst = document.getElementById('tab-institution');
      const tabGuest = document.getElementById('tab-guest');
      const categoryInput = document.getElementById('categoryInput');
      const heading = document.getElementById('regHeading');
      const subtitle = document.getElementById('regSubtitle');
      const emailInput = document.getElementById('email');
      const emailLabel = document.getElementById('emailLabel');
      const alertContainer = document.getElementById('regAlertContainer');

      clearRegValidationErrors();
      if (alertContainer) {
        alertContainer.classList.add('hidden');
        alertContainer.innerHTML = '';
      }

      categoryInput.value = cat;

      if (cat === 'institution') {
        tabInst.className = 'flex-1 py-2.5 px-4 rounded-xl text-xs sm:text-sm font-bold text-center transition-all cursor-pointer text-[#09436B] bg-white shadow-xs';
        tabInst.setAttribute('aria-selected', 'true');
        tabGuest.className = 'flex-1 py-2.5 px-4 rounded-xl text-xs sm:text-sm font-semibold text-center transition-all cursor-pointer text-slate-500 hover:text-slate-800';
        tabGuest.setAttribute('aria-selected', 'false');

        heading.textContent = 'Create Account';
        subtitle.textContent = 'For CSPC students and faculty/staff members.';
        emailLabel.textContent = 'CSPC Institutional Email *';
        emailInput.placeholder = 'juan@my.cspc.edu.ph';
      } else {
        tabGuest.className = 'flex-1 py-2.5 px-4 rounded-xl text-xs sm:text-sm font-bold text-center transition-all cursor-pointer text-[#09436B] bg-white shadow-xs';
        tabGuest.setAttribute('aria-selected', 'true');
        tabInst.className = 'flex-1 py-2.5 px-4 rounded-xl text-xs sm:text-sm font-semibold text-center transition-all cursor-pointer text-slate-500 hover:text-slate-800';
        tabInst.setAttribute('aria-selected', 'false');

        heading.textContent = 'Create Account';
        subtitle.textContent = 'For parents, guardians, and external campus visitors.';
        emailLabel.textContent = 'Email Address *';
        emailInput.placeholder = 'parent@gmail.com';
      }
    }

    function togglePasswordVisibility(fieldId, iconId) {
      const field = document.getElementById(fieldId);
      const icon = document.getElementById(iconId);
      if (!field || !icon) return;

      if (field.type === 'password') {
        field.type = 'text';
        icon.textContent = 'visibility_off';
      } else {
        field.type = 'password';
        icon.textContent = 'visibility';
      }
    }

    /**
     * Updates the 3-segment progress indicator:
     * Segment 1 = Length >= 8 -> [BLUE] [░] [░]
     * Segment 2 = Uppercase + Lowercase + Number -> [BLUE] [BLUE] [░]
     * Segment 3 = Special character -> [BLUE] [BLUE] [BLUE]
     */
    function calculateStrength(pw) {
      let segments = 0;
      const hasLength = pw.length >= 8;
      const hasUpper = /[A-Z]/.test(pw);
      const hasLower = /[a-z]/.test(pw);
      const hasNumber = /[0-9]/.test(pw);
      const hasSpecial = /[!@#$%^&*(),.?":{}|<>_\-+=\[\]\\\/`~]/.test(pw);

      if (hasLength) segments = 1;
      if (hasLength && hasUpper && hasLower && hasNumber) segments = 2;
      if (hasLength && hasUpper && hasLower && hasNumber && hasSpecial) segments = 3;

      return segments;
    }

    function updateStrengthMeter(pw) {
      const b1 = document.getElementById('bar1');
      const b2 = document.getElementById('bar2');
      const b3 = document.getElementById('bar3');
      const strengthText = document.getElementById('strengthText');
      const meter = document.getElementById('strengthMeter');
      const segments = calculateStrength(pw);

      meter.setAttribute('aria-valuenow', segments);

      // Colors: Unfilled = bg-slate-200, Filled = HANAP blue.
      const BLUE = 'h-full rounded-full';
      const GRAY = 'h-full rounded-full bg-slate-200';

      if (segments === 0) {
        b1.className = GRAY;
        b2.className = GRAY;
        b3.className = GRAY;
        strengthText.textContent = pw.length > 0 ? 'Password Strength: Too Short (< 8 chars)' : 'Password Strength: Empty';
        strengthText.className = 'font-semibold text-slate-500';
      } else if (segments === 1) {
        b1.className = BLUE;
        b2.className = GRAY;
        b3.className = GRAY;
        strengthText.textContent = 'Password Strength: Weak (Need Upper, Lower & Number)';
        strengthText.className = 'font-semibold text-blue-700';
      } else if (segments === 2) {
        b1.className = BLUE;
        b2.className = BLUE;
        b3.className = GRAY;
        strengthText.textContent = 'Password Strength: Medium (Need Special Character)';
        strengthText.className = 'font-semibold text-blue-700';
      } else {
        b1.className = BLUE;
        b2.className = BLUE;
        b3.className = BLUE;
        strengthText.textContent = 'Password Strength: Strong (All Requirements Met)';
        strengthText.className = 'font-semibold text-emerald-700';
      }

      [b1, b2, b3].forEach((bar, index) => {
        bar.style.backgroundColor = index < segments ? '#2B5B84' : '';
      });
    }

    function clearRegValidationErrors() {
      const fields = ['fullName', 'email', 'password', 'confirm_password'];
      fields.forEach(id => {
        const el = document.getElementById(id);
        if (el) {
          el.classList.remove('border-rose-500', 'ring-2', 'ring-rose-200');
          el.classList.add('border-slate-200/90');
        }
      });
    }

    function showRegAlert(title, message, actionType = null) {
      const alertContainer = document.getElementById('regAlertContainer');
      if (!alertContainer) return;

      let actionHtml = '';
      if (actionType === 'sign_in') {
        actionHtml = `
          <div class="pt-1.5 pl-7">
            <a href="/login" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-white hover:bg-rose-100/60 text-rose-900 font-bold border border-rose-300 shadow-2xs transition-all">
              <span>Sign In</span>
              <span class="material-symbols-outlined text-sm">login</span>
            </a>
          </div>
        `;
      } else if (actionType === 'switch_to_guest') {
        actionHtml = `
          <div class="pt-1.5 pl-7">
            <button type="button" data-reg-category="guest" class="px-3.5 py-1.5 rounded-xl bg-white hover:bg-rose-100/60 text-rose-900 font-bold border border-rose-300 shadow-2xs transition-all flex items-center gap-1.5 cursor-pointer">
              <span>Switch to Guest Registration</span>
              <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </button>
          </div>
        `;
      }

      alertContainer.innerHTML = `
        <div class="p-4 rounded-2xl bg-rose-50/90 border border-rose-200/90 text-rose-800 text-xs shadow-xs space-y-2 animate-fadeIn">
          <div class="flex items-start gap-2.5">
            <span class="material-symbols-outlined text-rose-600 text-lg shrink-0 mt-0.5">warning</span>
            <div class="flex-1">
              <strong class="font-bold text-rose-900 block mb-0.5 text-xs">${title}</strong>
              <div class="whitespace-pre-line text-rose-700 leading-relaxed font-medium">${message}</div>
            </div>
          </div>
          ${actionHtml}
        </div>
      `;
      alertContainer.classList.remove('hidden');
    }

    function handleRegisterSubmit(event) {
      clearRegValidationErrors();

      const nameInput = document.getElementById('fullName');
      const emailInput = document.getElementById('email');
      const passInput = document.getElementById('password');
      const confirmInput = document.getElementById('confirm_password');
      const termsInput = document.getElementById('termsCheck');

      const fullName = nameInput ? nameInput.value.trim() : '';
      const email = emailInput ? emailInput.value.trim().toLowerCase() : '';
      const password = passInput ? passInput.value : '';
      const confirm = confirmInput ? confirmInput.value : '';

      const errors = [];
      const invalidFields = [];

      // 1. Check empty/missing
      if (!fullName) {
        errors.push('• Please enter your full name.');
        invalidFields.push(nameInput);
      }
      if (!email) {
        errors.push('• Please enter your email address.');
        invalidFields.push(emailInput);
      }
      if (!password) {
        errors.push('• Please create a strong password.');
        invalidFields.push(passInput);
      }
      if (!confirm) {
        errors.push('• Please confirm your password.');
        invalidFields.push(confirmInput);
      }

      if (errors.length > 0) {
        event.preventDefault();
        invalidFields.forEach(el => el.classList.add('border-rose-500', 'ring-2', 'ring-rose-200'));
        showRegAlert('Complete the required information', errors.join('\n'));
        if (invalidFields[0]) invalidFields[0].focus();
        return false;
      }

      // 2. Email format check
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        event.preventDefault();
        emailInput.classList.add('border-rose-500', 'ring-2', 'ring-rose-200');
        showRegAlert('Invalid email format', 'Please enter a valid email address.');
        emailInput.focus();
        return false;
      }

      // 3. Institution domain check
      if (activeRegCategory === 'institution') {
        const domain = email.split('@')[1] || '';
        const cspcDomains = ['my.cspc.edu.ph', 'cspc.edu.ph'];
        if (!cspcDomains.includes(domain)) {
          event.preventDefault();
          emailInput.classList.add('border-rose-500', 'ring-2', 'ring-rose-200');
          showRegAlert(
            'Institutional email required',
            'Institution registration requires an official @my.cspc.edu.ph or @cspc.edu.ph email address.\nIf you are a parent or guest, please switch to the Guest registration tab.',
            'switch_to_guest'
          );
          emailInput.focus();
          return false;
        }
      }

      // 4. Password strength check (all 3 segments required)
      const strengthSegments = calculateStrength(password);
      if (strengthSegments < 3) {
        event.preventDefault();
        passInput.classList.add('border-rose-500', 'ring-2', 'ring-rose-200');
        showRegAlert(
          'Password does not meet requirements',
          'Please create a strong password containing:\n• Minimum 8 characters\n• At least one uppercase letter\n• At least one lowercase letter\n• At least one number\n• At least one special character'
        );
        passInput.focus();
        return false;
      }

      // 5. Password confirmation check
      if (password !== confirm) {
        event.preventDefault();
        confirmInput.classList.add('border-rose-500', 'ring-2', 'ring-rose-200');
        showRegAlert('Passwords do not match', 'Please enter the same password in both fields.');
        confirmInput.focus();
        return false;
      }

      // 6. Terms agreement check
      if (termsInput && !termsInput.checked) {
        event.preventDefault();
        showRegAlert('Agreement required', 'Please agree to the CSPC Lost & Found guidelines to proceed.');
        termsInput.focus();
        return false;
      }

      return true;
    }

    document.addEventListener('click', (event) => {
      const categoryButton = event.target.closest('[data-reg-category]');
      if (categoryButton) {
        switchRegCategory(categoryButton.dataset.regCategory);
        return;
      }

      const passwordButton = event.target.closest('[data-password-field]');
      if (passwordButton) {
        togglePasswordVisibility(passwordButton.dataset.passwordField, passwordButton.dataset.passwordIcon);
      }
    });

    document.getElementById('regForm').addEventListener('submit', handleRegisterSubmit);
    document.getElementById('password').addEventListener('input', (event) => {
      updateStrengthMeter(event.currentTarget.value);
    });
  </script>
</body>
</html>