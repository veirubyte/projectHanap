<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Report an Item - Project HANAP CSPC</title>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
  <style>
    @layer base {
      html, body { margin: 0; padding: 0; }
      body { overscroll-behavior: none; }
    }
    ::-webkit-scrollbar { display: none; }
  </style>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "background": "#F4F7FB",
            "primary": "#09436B",
            "primary-container": "#2B5B84",
            "on-surface": "#0F172A",
            "text-muted": "#64748B",
            "border-subtle": "#E2E8F0"
          },
          fontFamily: {
            sans: ["Plus Jakarta Sans", "sans-serif"]
          }
        }
      }
    };
  </script>
</head>
<body class="min-h-full bg-[#F4F7FB] font-sans text-slate-800 antialiased flex flex-col justify-between relative overflow-x-hidden">
  
  <!-- Ambient Aurora Canvas Background -->
  <div aria-hidden="true" class="fixed inset-0 pointer-events-none overflow-hidden z-0">
    <div class="absolute -top-36 left-1/2 -translate-x-1/2 w-[680px] h-[480px] bg-gradient-to-tr from-sky-400/20 via-indigo-300/15 to-teal-200/20 rounded-full blur-[110px]"></div>
    <div class="absolute top-1/3 -left-40 w-[420px] h-[420px] bg-blue-400/15 rounded-full blur-[100px]"></div>
    <div class="absolute -bottom-20 -right-20 w-[480px] h-[480px] bg-indigo-500/10 rounded-full blur-[120px]"></div>
  </div>

  <%- include('partials/navbar', { active: (typeof initialType !== 'undefined' && initialType === 'found') ? 'report-found' : 'report-lost' }) %>

  <!-- Main Container -->
  <main class="relative z-10 w-full pt-2 pb-16 px-3 sm:px-6 flex-1 flex flex-col items-center justify-center">
    <div class="w-full max-w-[840px] mx-auto py-2">
      
      <% if (error) { %>
        <div role="alert" class="mb-4 p-3.5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold">
          <%= error %>
        </div>
      <% } %>

      <!-- Top Segmented Toggle Switch: [ Lost ] [ Found ] -->
      <div class="flex flex-col items-center text-center mb-6">
        <% if (user && (user.role === 'parent/guest' || user.role === 'guest' || user.role === 'parent')) { %>
          <div class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-amber-50/90 border border-amber-200 text-amber-900 text-xs font-semibold mb-3 shadow-2xs">
            <span class="material-symbols-outlined text-[18px] text-amber-600">shield</span>
            <span>Guest Notice: Guests are permitted to report lost items only. Please surrender found items directly to Campus Security.</span>
          </div>
        <% } else { %>
          <div class="inline-flex p-1.5 bg-white/80 backdrop-blur-xl border border-white/90 rounded-full mb-3 shadow-[0_8px_20px_rgba(0,0,0,0.04),inset_0_1px_2px_rgba(255,255,255,0.8)]" id="reportModeToggle" role="tablist">
            <button type="button" id="tabLostBtn" onclick="switchReportType('lost')" class="px-6 py-2 rounded-full text-xs font-bold transition-all flex items-center gap-1.5 <%= (typeof initialType === 'undefined' || initialType !== 'found') ? 'bg-gradient-to-r from-rose-600 to-rose-700 text-white shadow-[0_4px_14px_rgba(225,29,72,0.35)]' : 'text-slate-600 hover:text-slate-900 hover:bg-white/50' %>">
              <span>🔍</span>
              <span>I Lost Something</span>
            </button>
            <button type="button" id="tabFoundBtn" onclick="switchReportType('found')" class="px-6 py-2 rounded-full text-xs font-bold transition-all flex items-center gap-1.5 <%= (typeof initialType !== 'undefined' && initialType === 'found') ? 'bg-gradient-to-r from-[#2B5B84] to-[#1E40AF] text-white shadow-[0_4px_14px_rgba(43,91,132,0.35)]' : 'text-slate-600 hover:text-slate-900 hover:bg-white/50' %>">
              <span>🙌</span>
              <span>I Found Something</span>
            </button>
          </div>
        <% } %>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight" id="formHeading">
          <%= (user && (user.role === 'parent/guest' || user.role === 'guest' || user.role === 'parent')) ? 'Report a Lost Item' : ((typeof initialType !== 'undefined' && initialType === 'found') ? 'Report a Found Item' : 'Report a Lost Item') %>
        </h1>
        <p class="text-xs text-slate-500 mt-1 max-w-md" id="formSubheading">
          <%= (user && (user.role === 'parent/guest' || user.role === 'guest' || user.role === 'parent')) ? 'Describe your missing belonging accurately to facilitate campus matching and security identification.' : ((typeof initialType !== 'undefined' && initialType === 'found') ? 'Provide clear details and custody preferences so the rightful owner can verify it.' : 'Describe your lost item accurately to allow automated smart matching across campus.') %>
        </p>
      </div>

      <!-- Centered Frosted-Glass Studio Container -->
      <form action="/items/report" method="POST" enctype="multipart/form-data" class="bg-white/[0.85] backdrop-blur-2xl p-6 sm:p-8 rounded-3xl border border-white/80 shadow-[0_20px_50px_rgba(15,23,42,0.08),0_1px_1px_rgba(255,255,255,0.9)_inset] flex flex-col gap-6" id="itemReportForm">
        <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
        <% } %>
        <input type="hidden" name="report_type" id="reportTypeInput" value="<%= (user && (user.role === 'parent/guest' || user.role === 'guest' || user.role === 'parent')) ? 'lost' : ((typeof initialType !== 'undefined' && initialType === 'found') ? 'found' : 'lost') %>"/>

        <!-- 2-Column Inputs Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          
          <!-- 1. Item Title -->
          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-800 uppercase tracking-wider" for="itemName">
              Item Title *
            </label>
            <input 
              class="w-full h-11 px-3.5 rounded-xl border border-slate-200/90 bg-white/80 backdrop-blur-sm text-slate-900 text-sm focus:border-sky-500 focus:ring-4 focus:ring-sky-500/15 focus:bg-white outline-none transition-all shadow-2xs" 
              id="itemName" 
              name="item_name" 
              placeholder="e.g. Blue CSPC CCS ID Lanyard, Casio fx-991EX" 
              required 
              type="text"
            />
          </div>

          <!-- 2. Category Dropdown -->
          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-800 uppercase tracking-wider" for="categorySelect">
              Category *
            </label>
            <div class="relative">
              <select 
                class="w-full h-11 px-3.5 pr-9 rounded-xl border border-slate-200/90 bg-white/80 backdrop-blur-sm text-slate-900 text-sm appearance-none focus:border-sky-500 focus:ring-4 focus:ring-sky-500/15 focus:bg-white outline-none transition-all shadow-2xs" 
                id="categorySelect" 
                name="category" 
                required>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat %>"><%= cat %></option>
                <% }) %>
              </select>
              <span class="material-symbols-outlined absolute right-3 top-3 text-slate-400 text-[20px] pointer-events-none">expand_more</span>
            </div>
          </div>

          <!-- 3. Campus Location with Interactive Quick-Chips -->
          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-800 uppercase tracking-wider" for="campusLocation">
              Campus Location *
            </label>
            <div class="relative">
              <input 
                class="w-full h-11 px-3.5 rounded-xl border border-slate-200/90 bg-white/80 backdrop-blur-sm text-slate-900 text-sm focus:border-sky-500 focus:ring-4 focus:ring-sky-500/15 focus:bg-white outline-none transition-all shadow-2xs" 
                id="campusLocation" 
                name="location_found_lost" 
                placeholder="Specific campus area, floor, or room" 
                required 
                type="text"
              />
            </div>
            <!-- Location Quick-Chips -->
            <div class="flex flex-wrap items-center gap-1.5 pt-1">
              <button type="button" onclick="setLocation('Main Library')" class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-sky-50 border border-sky-200 text-[#09436B] hover:bg-sky-100 transition-all cursor-pointer">Main Library</button>
              <button type="button" onclick="setLocation('ComLab 2')" class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-white/80 border border-slate-200 text-slate-600 hover:bg-sky-50 hover:text-[#09436B] transition-all cursor-pointer">ComLab 2</button>
              <button type="button" onclick="setLocation('Canteen')" class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-white/80 border border-slate-200 text-slate-600 hover:bg-sky-50 hover:text-[#09436B] transition-all cursor-pointer">Canteen</button>
              <button type="button" onclick="setLocation('Gym')" class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-white/80 border border-slate-200 text-slate-600 hover:bg-sky-50 hover:text-[#09436B] transition-all cursor-pointer">Gym</button>
              <button type="button" onclick="setLocation('Student Pavilion')" class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-white/80 border border-slate-200 text-slate-600 hover:bg-sky-50 hover:text-[#09436B] transition-all cursor-pointer">Student Pavilion</button>
              <button type="button" onclick="setLocation('Main Gate Guardhouse')" class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-white/80 border border-slate-200 text-slate-600 hover:bg-sky-50 hover:text-[#09436B] transition-all cursor-pointer">Guardhouse</button>
            </div>
          </div>

          <!-- 4. Description -->
          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-bold text-slate-800 uppercase tracking-wider" for="itemDescription">
              Description &amp; Marks *
            </label>
            <textarea 
              class="w-full h-[88px] p-3 rounded-xl border border-slate-200/90 bg-white/80 backdrop-blur-sm text-slate-900 text-sm focus:border-sky-500 focus:ring-4 focus:ring-sky-500/15 focus:bg-white outline-none transition-all shadow-2xs resize-none" 
              id="itemDescription" 
              name="description" 
              placeholder="Detail distinctive colors, brands, stickers, scratches, or accessories..." 
              required
            ></textarea>
          </div>
        </div>

        <!-- Smart Photo Dropzone -->
        <div class="flex flex-col gap-1.5">
          <div class="flex items-center justify-between">
            <label class="text-xs font-bold text-slate-800 uppercase tracking-wider">Photo</label>
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-800 border border-emerald-500/20 text-[11px] font-semibold">
              ⚡ Safe Storage • Privacy Protected
            </span>
          </div>
          <div class="flex flex-col sm:flex-row items-center gap-3">
            <label class="flex-1 w-full border-2 border-dashed border-sky-300/70 bg-white/50 hover:bg-white/80 backdrop-blur-md rounded-2xl p-4 flex items-center justify-center gap-2 cursor-pointer hover:border-[#2B5B84] transition-all group shadow-inner">
              <input accept="image/jpeg,image/png,image/webp" class="hidden" id="photoInput" name="photo" type="file" onchange="handlePhotoSelect(event)"/>
              <span class="material-symbols-outlined text-[#2B5B84] group-hover:scale-110 transition-transform text-[24px]">photo_camera</span>
              <span class="text-xs font-bold text-slate-600 group-hover:text-[#2B5B84] transition-colors" id="photoLabel">
                Click to attach photo (JPEG, PNG, WebP)
              </span>
            </label>
            <!-- Thumbnail Preview Chip -->
            <div id="photoPreviewChip" class="hidden items-center gap-2.5 p-2 pr-3 rounded-2xl border border-white/80 bg-white/85 backdrop-blur-xl shadow-xs shrink-0">
              <img id="photoPreviewImg" alt="Thumbnail" class="w-10 h-10 rounded-xl object-cover ring-1 ring-black/5" src=""/>
              <span id="photoPreviewName" class="text-xs font-semibold text-slate-800 truncate max-w-[120px]">photo.jpg</span>
              <button aria-label="Remove" class="text-slate-400 hover:text-rose-600 transition-colors p-1" type="button" onclick="removePhoto()">
                <span class="material-symbols-outlined text-[16px]">close</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Found Verification Glass Pod (Shown for Found Items, optional for Lost) -->
        <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-br from-sky-500/10 via-slate-50/60 to-indigo-500/5 backdrop-blur-xl border border-sky-200/60 shadow-xs flex flex-col gap-4">
          <div class="flex items-center gap-2 text-[#09436B] font-bold text-sm">
            <span class="material-symbols-outlined text-[20px]">key</span>
            <span>Ownership Verification Challenge (Optional)</span>
          </div>
          <p class="text-xs text-slate-600 -mt-2">
            Add a private question and its correct answer. Both are optional, but you must enter both or leave both blank. Claimants never see the correct answer.
          </p>
          <input 
            class="w-full h-11 px-3.5 rounded-xl border border-slate-200/90 bg-white/90 backdrop-blur-sm text-slate-900 text-sm focus:border-sky-500 focus:ring-4 focus:ring-sky-500/15 focus:bg-white outline-none transition-all shadow-2xs" 
            id="verificationChallenge" 
            name="secret_challenge" 
            placeholder="e.g. What specific pin, keychain, or sticker is attached to it?" 
            maxlength="500"
            type="text"
          />
          <input
            class="w-full h-11 px-3.5 rounded-xl border border-slate-200/90 bg-white/90 backdrop-blur-sm text-slate-900 text-sm focus:border-sky-500 focus:ring-4 focus:ring-sky-500/15 focus:bg-white outline-none transition-all shadow-2xs"
            id="verificationAnswer"
            name="secret_answer"
            placeholder="Private correct answer (never shown to claimants)"
            maxlength="500"
            type="password"
            autocomplete="off"
          />

          <!-- Custody Card Toggle -->
          <div class="flex flex-col gap-2 pt-1">
            <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">Custody Preference</span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <label class="flex items-center gap-3 p-3 rounded-xl cursor-pointer transition-all border border-sky-300 bg-white text-[#09436B] shadow-xs hover:shadow-sm font-semibold text-xs">
                <input checked class="w-4 h-4 text-[#2B5B84] focus:ring-[#3B82F6]/30 accent-[#2B5B84] cursor-pointer" name="custody_mode" type="radio" value="peer_meetup"/>
                <div>
                  <span class="block font-bold">🤝 Peer Meetup</span>
                  <span class="text-[11px] font-normal text-slate-500">Coordinate secure campus handover once verified</span>
                </div>
              </label>
              <label class="flex items-center gap-3 p-3 rounded-xl cursor-pointer transition-all border border-slate-200 bg-white/70 hover:bg-white text-slate-700 shadow-xs hover:shadow-sm font-semibold text-xs">
                <input class="w-4 h-4 text-[#2B5B84] focus:ring-[#3B82F6]/30 accent-[#2B5B84] cursor-pointer" name="custody_mode" type="radio" value="security_desk"/>
                <div>
                  <span class="block font-bold">🛡️ Security Desk</span>
                  <span class="text-[11px] font-normal text-slate-500">Turned over to Main Gate Guardhouse / L&amp;F Office</span>
                </div>
              </label>
            </div>
          </div>
        </div>

        <!-- Footer Actions -->
        <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-200/80">
          <a class="px-5 py-2.5 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-all" href="/dashboard">
            Cancel
          </a>
          <button class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-gradient-to-r from-[#2B5B84] via-[#1E4E75] to-[#09436B] hover:brightness-110 text-white font-bold text-xs sm:text-sm shadow-[0_8px_20px_rgba(43,91,132,0.32)] transition-all transform active:scale-[0.99] cursor-pointer" type="submit">
            <span>Submit &amp; Match</span>
            <span class="material-symbols-outlined text-[17px]">arrow_forward</span>
          </button>
        </div>
      </form>
    </div>
  </main>

  <!-- Footer -->
  <footer class="relative z-10 w-full bg-white/60 backdrop-blur-xl border-t border-white/60 py-4">
    <div class="max-w-7xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-500">
      <div class="flex items-center gap-2">
        <span class="font-bold text-[#09436B]">Project HANAP</span>
        <span>•</span>
        <span>Camarines Sur Polytechnic Colleges</span>
      </div>
      <div>© 2026 CSPC Campus Care Network</div>
    </div>
  </footer>

  <script>
    const challengeInput = document.getElementById('verificationChallenge');
    const answerInput = document.getElementById('verificationAnswer');

    function validateChallengePair() {
      const hasChallenge = challengeInput.value.trim().length > 0;
      const hasAnswer = answerInput.value.trim().length > 0;
      challengeInput.required = hasAnswer;
      answerInput.required = hasChallenge;
      challengeInput.setCustomValidity(hasAnswer && !hasChallenge ? 'Enter the ownership question too, or clear the private answer.' : '');
      answerInput.setCustomValidity(hasChallenge && !hasAnswer ? 'Enter the private correct answer for this question.' : '');
    }

    challengeInput.addEventListener('input', validateChallengePair);
    answerInput.addEventListener('input', validateChallengePair);

    function switchReportType(type) {
      const lostBtn = document.getElementById('tabLostBtn');
      const foundBtn = document.getElementById('tabFoundBtn');
      const input = document.getElementById('reportTypeInput');
      const heading = document.getElementById('formHeading');
      const subheading = document.getElementById('formSubheading');

      input.value = type;
      if (type === 'lost') {
        lostBtn.className = "px-6 py-2 rounded-full text-xs font-bold transition-all flex items-center gap-1.5 bg-gradient-to-r from-rose-600 to-rose-700 text-white shadow-[0_4px_14px_rgba(225,29,72,0.35)]";
        foundBtn.className = "px-6 py-2 rounded-full text-xs font-bold transition-all flex items-center gap-1.5 text-slate-600 hover:text-slate-900 hover:bg-white/50";
        heading.textContent = "Report a Lost Item";
        subheading.textContent = "Describe your lost item accurately to allow automated smart matching across campus.";
      } else {
        foundBtn.className = "px-6 py-2 rounded-full text-xs font-bold transition-all flex items-center gap-1.5 bg-gradient-to-r from-[#2B5B84] to-[#1E40AF] text-white shadow-[0_4px_14px_rgba(43,91,132,0.35)]";
        lostBtn.className = "px-6 py-2 rounded-full text-xs font-bold transition-all flex items-center gap-1.5 text-slate-600 hover:text-slate-900 hover:bg-white/50";
        heading.textContent = "Report a Found Item";
        subheading.textContent = "Provide clear details and custody preferences so the rightful owner can verify it.";
      }
    }

    function setLocation(loc) {
      const locInput = document.getElementById('campusLocation');
      if (locInput) {
        locInput.value = loc;
        locInput.focus();
      }
    }

    function handlePhotoSelect(event) {
      const file = event.target.files[0];
      if (!file) return;

      const previewChip = document.getElementById('photoPreviewChip');
      const previewImg = document.getElementById('photoPreviewImg');
      const previewName = document.getElementById('photoPreviewName');
      const photoLabel = document.getElementById('photoLabel');

      previewName.textContent = file.name;
      photoLabel.textContent = `Selected: ${file.name}`;

      const reader = new FileReader();
      reader.onload = function(e) {
        previewImg.src = e.target.result;
        previewChip.classList.remove('hidden');
        previewChip.classList.add('flex');
      };
      reader.readAsDataURL(file);
    }

    function removePhoto() {
      const fileInput = document.getElementById('photoInput');
      const previewChip = document.getElementById('photoPreviewChip');
      const photoLabel = document.getElementById('photoLabel');

      fileInput.value = '';
      previewChip.classList.add('hidden');
      previewChip.classList.remove('flex');
      photoLabel.textContent = 'Click to attach photo (JPEG, PNG, WebP)';
    }
  </script>
</body>
</html>
